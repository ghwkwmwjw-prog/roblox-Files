local State = {
	stage = 0,
	photos = { car = false, body = false },
	keyStep = 0,
	hasKey = {},
	unlocked = {},
	code = {},
	notesGot = {},
	noteCount = 0,
	gear = false,
	introStarted = false,
}

local KEYS = {
	{ name = "النحاسي", color = rgb(205, 127, 50) },
	{ name = "الأخضر", color = rgb(60, 220, 90) },
	{ name = "الأزرق", color = rgb(70, 140, 255) },
	{ name = "الأصفر", color = rgb(255, 220, 60) },
	{ name = "البنفسجي", color = rgb(175, 90, 255) },
	{ name = "الأبيض", color = rgb(255, 255, 255) },
}

------------------------------------------------------------------
-- الإضاءة (ليل + ضباب)
------------------------------------------------------------------
local function setNight()
	Lighting.ClockTime = 0
	Lighting.Brightness = 0.6
	Lighting.Ambient = rgb(20, 22, 32)
	Lighting.OutdoorAmbient = rgb(28, 30, 44)
	Lighting.FogColor = rgb(55, 62, 72)
	Lighting.FogStart = 15
	Lighting.FogEnd = 260
	local atm = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atm.Density = 0.4
	atm.Offset = 0.2
	atm.Color = rgb(120, 130, 150)
	atm.Decay = rgb(70, 80, 100)
	atm.Glare = 0
	atm.Haze = 1.6
	atm.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "HorrorCC"
	cc.Saturation = -0.35
	cc.Contrast = 0.12
	cc.TintColor = rgb(215, 225, 255)
	cc.Parent = Lighting
end

------------------------------------------------------------------
-- شخصيات بسيطة (مدير / جثة)
------------------------------------------------------------------
local function makeFigure(name, cfg)
	cfg = cfg or {}
	local m = Instance.new("Model")
	m.Name = name
	local function limb(n, size, pos, col)
		local p = mk(m, n, size, CFrame.new(pos), col)
		p.CanCollide = false
		return p
	end
	local shirt = cfg.shirt or rgb(40, 60, 120)
	local skin = cfg.skin or rgb(235, 190, 150)
	local pants = cfg.pants or rgb(30, 30, 40)
	local torso = limb("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), shirt)
	local head = limb("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), skin)
	limb("RArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), shirt)
	limb("LArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), shirt)
	limb("RLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), pants)
	limb("LLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), pants)
	if cfg.face then
		local d = Instance.new("Decal")
		d.Texture = "rbxasset://textures/face.png"
		d.Face = Enum.NormalId.Front
		d.Parent = head
	end
	if cfg.cap then
		limb("Cap", Vector3.new(1.4, 0.4, 1.4), Vector3.new(0, 5.35, 0), cfg.capColor or rgb(20, 25, 50))
	end
	m.PrimaryPart = torso
	return m
end

------------------------------------------------------------------
-- سيارة الشرطة
------------------------------------------------------------------
local function buildPoliceCar(opts)
	opts = opts or {}
	local m = Instance.new("Model")
	m.Name = "PoliceCar"
	local black, white = rgb(18, 18, 22), rgb(235, 235, 235)
	local body = mk(m, "Body", Vector3.new(7, 2, 15), Vector3.new(0, 2, 0), black, Enum.Material.Metal)
	mk(m, "Cabin", Vector3.new(6, 1.9, 7), Vector3.new(0, 3.95, 0.8), rgb(70, 90, 120), Enum.Material.Glass, 0.35)
	mk(m, "Roof", Vector3.new(6.2, 0.3, 5.6), Vector3.new(0, 5.0, 0.8), black, Enum.Material.Metal)
	local stripe = mk(m, "Stripe", Vector3.new(7.1, 1.1, 6), Vector3.new(0, 1.9, 1.2), white, Enum.Material.Metal)
	sgText(stripe, Enum.NormalId.Right, "شرطة", rgb(10, 10, 10))
	sgText(stripe, Enum.NormalId.Left, "شرطة", rgb(10, 10, 10))
	local offs = {
		Vector3.new(3.6, 1.2, -4.8),
		Vector3.new(-3.6, 1.2, -4.8),
		Vector3.new(3.6, 1.2, 4.8),
		Vector3.new(-3.6, 1.2, 4.8),
	}
	for i, off in ipairs(offs) do
		local w = mk(m, "Wheel" .. i, Vector3.new(0.9, 2.4, 2.4), CFrame.new(off), rgb(10, 10, 10))
		w.Shape = Enum.PartType.Cylinder
	end
	for _, sx in ipairs({ -2.3, 2.3 }) do
		local hl = mk(m, "Headlight", Vector3.new(1.3, 0.8, 0.3), Vector3.new(sx, 2.4, -7.6), rgb(255, 245, 200), Enum.Material.Neon)
		local sp = addLight(hl, "SpotLight", rgb(255, 245, 210), 3, 90)
		sp.Angle = 55
		sp.Face = Enum.NormalId.Front
		mk(m, "Taillight", Vector3.new(1.3, 0.6, 0.3), Vector3.new(sx, 2.5, 7.6), rgb(200, 20, 20), Enum.Material.Neon)
	end
	local rb = mk(m, "BarRed", Vector3.new(2, 0.5, 1), Vector3.new(-1.2, 5.35, 0.8), rgb(255, 30, 30), Enum.Material.Neon)
	local bb = mk(m, "BarBlue", Vector3.new(2, 0.5, 1), Vector3.new(1.2, 5.35, 0.8), rgb(40, 80, 255), Enum.Material.Neon)
	addLight(rb, "PointLight", rgb(255, 0, 0), opts.siren and 4 or 0, 30)
	addLight(bb, "PointLight", rgb(0, 60, 255), 0, 30)
	mk(m, "Trunk", Vector3.new(6.2, 0.4, 3), Vector3.new(0, 3.2, 6), black, Enum.Material.Metal)
	local gear = mk(m, "Gear", Vector3.new(3.2, 1, 2), Vector3.new(0, 3.5, 6), rgb(40, 60, 40), Enum.Material.Fabric, 1)
	gear.CanCollide = false
	m.PrimaryPart = body
	return m
end

------------------------------------------------------------------
-- مكتب المدير
------------------------------------------------------------------
local OFFICE = Vector3.new(0, 500, 0)

local function buildOffice()
	local m = Instance.new("Model")
	m.Name = "Office"
	m.Parent = world
	local o = OFFICE
	local wallC = rgb(176, 170, 152)
	mk(m, "Floor", Vector3.new(34, 1, 34), o + Vector3.new(0, -0.5, 0), rgb(72, 54, 38), Enum.Material.WoodPlanks)
	mk(m, "Ceiling", Vector3.new(34, 1, 34), o + Vector3.new(0, 14.5, 0), rgb(205, 205, 198))
	mk(m, "WallN", Vector3.new(34, 14, 1), o + Vector3.new(0, 7, -17), wallC)
	mk(m, "WallS", Vector3.new(34, 14, 1), o + Vector3.new(0, 7, 17), wallC)
	mk(m, "WallE", Vector3.new(1, 14, 34), o + Vector3.new(17, 7, 0), wallC)
	mk(m, "WallW", Vector3.new(1, 14, 34), o + Vector3.new(-17, 7, 0), wallC)
	local sign = mk(m, "Sign", Vector3.new(16, 4, 0.3), o + Vector3.new(0, 10, -16.4), rgb(15, 25, 55))
	sgText(sign, Enum.NormalId.Back, "مديرية الشرطة", rgb(255, 215, 90))
	mk(m, "Poster", Vector3.new(4, 5, 0.2), o + Vector3.new(-10, 8, -16.4), rgb(120, 30, 30))
	mk(m, "Window", Vector3.new(0.3, 6, 8), o + Vector3.new(16.4, 8, -4), rgb(30, 50, 80), Enum.Material.Glass, 0.2)
	mk(m, "Desk", Vector3.new(12, 0.6, 4.5), o + Vector3.new(0, 3.3, -8), rgb(90, 55, 30), Enum.Material.Wood)
	mk(m, "DeskBody", Vector3.new(11, 3, 4), o + Vector3.new(0, 1.5, -8.2), rgb(70, 42, 24), Enum.Material.Wood)
	local lamp = mk(m, "Lamp", Vector3.new(1, 1, 1), o + Vector3.new(4, 4.4, -8), rgb(255, 220, 150), Enum.Material.Neon)
	lamp.Shape = Enum.PartType.Ball
	addLight(lamp, "PointLight", rgb(255, 200, 130), 1.5, 30)
	local cl = mk(m, "CeilLight", Vector3.new(6, 0.3, 2), o + Vector3.new(0, 13.8, -4), rgb(255, 250, 235), Enum.Material.Neon)
	addLight(cl, "PointLight", rgb(255, 245, 225), 1, 45)
	local mgr = makeFigure("Manager", { shirt = rgb(30, 50, 35), pants = rgb(25, 25, 30), face = true, cap = true })
	mgr.Parent = m
	mgr:PivotTo(CFrame.new(o + Vector3.new(0, 3, -11)) * CFrame.Angles(0, math.rad(180), 0))
end

------------------------------------------------------------------
-- الطريق السريع الفاضي
------------------------------------------------------------------
local function lampPost(parent, pos, side, flick)
	mk(parent, "Pole", Vector3.new(0.6, 16, 0.6), pos + Vector3.new(0, 8, 0), rgb(25, 25, 28), Enum.Material.Metal)
	mk(parent, "Arm", Vector3.new(3.6, 0.4, 0.4), pos + Vector3.new(-side * 1.8, 16, 0), rgb(25, 25, 28), Enum.Material.Metal)
	local head = mk(parent, "LampHead", Vector3.new(1.4, 0.6, 1.4), pos + Vector3.new(-side * 3.4, 15.6, 0), rgb(255, 230, 170), Enum.Material.Neon)
	local l = addLight(head, "PointLight", rgb(255, 215, 150), 1.6, 48)
	regLight(l, flick)
end

local function buildHighway()
	local m = Instance.new("Model")
	m.Name = "Highway"
	m.Parent = world
	mk(m, "Ground", Vector3.new(2400, 1, 2400), Vector3.new(200, -0.5, -800), rgb(22, 30, 22), Enum.Material.Grass)
	mk(m, "Road", Vector3.new(30, 0.2, 1160), Vector3.new(200, 0.1, -540), rgb(35, 35, 38), Enum.Material.Asphalt)
	local z = 20
	while z > -1090 do
		mk(m, "Dash", Vector3.new(0.5, 0.05, 6), Vector3.new(200, 0.23, z), rgb(230, 190, 40))
		z -= 14
	end
	mk(m, "EdgeL", Vector3.new(0.4, 0.05, 1160), Vector3.new(186, 0.23, -540), rgb(210, 210, 210))
	mk(m, "EdgeR", Vector3.new(0.4, 0.05, 1160), Vector3.new(214, 0.23, -540), rgb(210, 210, 210))
	mk(m, "RailL", Vector3.new(0.4, 1.2, 1150), Vector3.new(182, 1.4, -525), rgb(110, 110, 115), Enum.Material.Metal)
	mk(m, "RailR", Vector3.new(0.4, 1.2, 1150), Vector3.new(218, 1.4, -525), rgb(110, 110, 115), Enum.Material.Metal)
	local i = 0
	local lz = -20
	while lz > -1060 do
		i += 1
		local side = (i % 2 == 0) and 1 or -1
		lampPost(m, Vector3.new(200 + side * 24, 0, lz), side, math.random() < 0.35)
		lz -= 70
	end
	for _ = 1, 90 do
		local tz = math.random(-1090, 20)
		local sgn = math.random(2) == 1 and 1 or -1
		local x = 200 + sgn * (28 + math.random() * 80)
		local h = 10 + math.random() * 8
		mk(m, "Trunk", Vector3.new(1.6, h, 1.6), Vector3.new(x, h / 2, tz), rgb(30, 22, 18), Enum.Material.Wood)
		local s = 7 + math.random() * 6
		local lf = mk(m, "Leaves", Vector3.new(s, s, s), Vector3.new(x, h + s * 0.3, tz), rgb(14, 30, 18), Enum.Material.Grass)
		lf.Shape = Enum.PartType.Ball
	end
end

------------------------------------------------------------------
-- الحارة المسكونة
------------------------------------------------------------------
local houses = {}
local gateLeaves = {}
local HING_L = CFrame.new(188, 7, -1100)
local HING_R = CFrame.new(212, 7, -1100)

local function setGate(deg)
	local a = math.rad(deg)
	gateLeaves.L:PivotTo(HING_L * CFrame.Angles(0, a, 0) * CFrame.new(6, 0, 0))
	gateLeaves.R:PivotTo(HING_R * CFrame.Angles(0, -a, 0) * CFrame.new(-6, 0, 0))
end

local function makeLeaf(name)
	local m = Instance.new("Model")
	m.Name = name
	local center = mk(m, "Center", Vector3.new(12, 11.4, 0.2), CFrame.new(0, 0, 0), rgb(50, 40, 35), Enum.Material.Metal, 1)
	mk(m, "Top", Vector3.new(12, 0.6, 0.6), CFrame.new(0, 5.7, 0), rgb(45, 35, 30), Enum.Material.Metal)
	mk(m, "Bottom", Vector3.new(12, 0.6, 0.6), CFrame.new(0, -5.7, 0), rgb(45, 35, 30), Enum.Material.Metal)
	for k = -5, 5 do
		mk(m, "Bar", Vector3.new(0.3, 11.4, 0.3), CFrame.new(k * 1.1, 0, 0), rgb(45, 35, 30), Enum.Material.Metal)
	end
	m.PrimaryPart = center
	m.Parent = world
	return m
end

local function buildHouse(parent, idx, cx, cz, dir)
	local h = Instance.new("Model")
	h.Name = "House" .. idx
	h.Parent = parent
	local H = 13
	local v = math.random(-8, 8)
	local wc = rgb(92 + v, 80 + v, 68 + v)
	local mat = Enum.Material.Concrete
	mk(h, "Floor", Vector3.new(34, 0.4, 28), Vector3.new(cx, 0.2, cz), rgb(60, 45, 32), Enum.Material.WoodPlanks)
	mk(h, "Back", Vector3.new(1, H, 28), Vector3.new(cx - dir * 16.5, 0.4 + H / 2, cz), wc, mat)
	local fx = cx + dir * 16.5
	mk(h, "FrontA", Vector3.new(1, H, 11), Vector3.new(fx, 0.4 + H / 2, cz - 8.5), wc, mat)
	mk(h, "FrontB", Vector3.new(1, H, 11), Vector3.new(fx, 0.4 + H / 2, cz + 8.5), wc, mat)
	mk(h, "Lintel", Vector3.new(1, H - 9, 6), Vector3.new(fx, 0.4 + 9 + (H - 9) / 2, cz), wc, mat)
	mk(h, "SideA", Vector3.new(34, H, 1), Vector3.new(cx, 0.4 + H / 2, cz - 14), wc, mat)
	mk(h, "SideB", Vector3.new(34, H, 1), Vector3.new(cx, 0.4 + H / 2, cz + 14), wc, mat)
	mk(h, "Roof", Vector3.new(36, 1, 30), Vector3.new(cx, 0.4 + H + 0.5, cz), rgb(35, 28, 28), Enum.Material.Slate)
	-- أثاث
	mk(h, "TableA", Vector3.new(4, 2.6, 3), Vector3.new(cx - dir * 9, 0.4 + 1.3, cz + 7), rgb(80, 52, 30), Enum.Material.Wood)
	mk(h, "TableB", Vector3.new(4, 2.6, 3), Vector3.new(cx - dir * 9, 0.4 + 1.3, cz - 7), rgb(80, 52, 30), Enum.Material.Wood)
	mk(h, "Bed", Vector3.new(6, 1.4, 3), Vector3.new(cx + dir * 9, 0.4 + 0.7, cz - 9), rgb(70, 60, 70), Enum.Material.Fabric)
	-- ضوء داخلي خافت
	local bulb = mk(h, "Bulb", Vector3.new(0.8, 0.8, 0.8), Vector3.new(cx, 0.4 + H - 1.2, cz), rgb(255, 200, 120), Enum.Material.Neon)
	bulb.Shape = Enum.PartType.Ball
	local l = addLight(bulb, "PointLight", rgb(255, 190, 110), 0.5, 26)
	regLight(l, math.random() < 0.6)
	local info = {
		model = h,
		center = Vector3.new(cx, 0.4, cz),
		dir = dir,
		doorPos = Vector3.new(fx, 0.4, cz),
		tableA = Vector3.new(cx - dir * 9, 3.0, cz + 7),
		tableB = Vector3.new(cx - dir * 9, 3.0, cz - 7),
	}
	table.insert(houses, info)
end

local STATION_DEFS = {
	{ pos = Vector3.new(51, 0, -1250), normal = Vector3.new(1, 0, 0) },
	{ pos = Vector3.new(349, 0, -1250), normal = Vector3.new(-1, 0, 0) },
	{ pos = Vector3.new(51, 0, -1400), normal = Vector3.new(1, 0, 0) },
	{ pos = Vector3.new(349, 0, -1400), normal = Vector3.new(-1, 0, 0) },
	{ pos = Vector3.new(200, 0, -1499), normal = Vector3.new(0, 0, 1) },
}
local stations = {}

local function buildStation(parent, i, def)
	local k = KEYS[i]
	local base = CFrame.lookAt(def.pos + def.normal * 0.45, def.pos + def.normal * 5)
	local model = Instance.new("Model")
	model.Name = "Station" .. i
	model.Parent = parent
	local plate = mk(model, "Plate", Vector3.new(9, 12, 0.8), base * CFrame.new(0, 6.4, 0), rgb(40, 38, 40), Enum.Material.Metal)
	local fade = { plate }
	table.insert(fade, mk(model, "StripeL", Vector3.new(0.5, 11, 0.2), base * CFrame.new(-3.2, 6.4, -0.5), k.color, Enum.Material.Neon))
	table.insert(fade, mk(model, "StripeR", Vector3.new(0.5, 11, 0.2), base * CFrame.new(3.2, 6.4, -0.5), k.color, Enum.Material.Neon))
	table.insert(fade, mk(model, "StripeT", Vector3.new(7, 0.5, 0.2), base * CFrame.new(0, 11.3, -0.5), k.color, Enum.Material.Neon))
	table.insert(fade, mk(model, "Chain", Vector3.new(10, 0.4, 0.4), base * CFrame.new(0, 6, -0.7) * CFrame.Angles(0, 0, math.rad(8)), rgb(80, 80, 85), Enum.Material.Metal))
	local lock = mk(model, "Lock", Vector3.new(1.8, 2.4, 1), base * CFrame.new(0, 5.2, -1), k.color, Enum.Material.Neon)
	local lamp = mk(model, "Lamp", Vector3.new(1.4, 1.4, 1.4), base * CFrame.new(0, 14, -1.2), k.color, Enum.Material.Neon)
	lamp.Shape = Enum.PartType.Ball
	local pl = addLight(lamp, "PointLight", k.color, 0.5, 22)
	local lb = sgText(plate, Enum.NormalId.Front, "قفل " .. k.name, rgb(225, 225, 225))
	lb.Size = UDim2.fromScale(1, 0.18)
	lb.Position = UDim2.fromScale(0, 0.06)
	local s = { lock = lock, pos = def.pos + def.normal * 3 + Vector3.new(0, 5, 0) }
	function s.unlock()
		lock.Anchored = false
		lock.CanCollide = true
		pl.Brightness = 3
		pl.Range = 40
		for _, p in ipairs(fade) do
			p.CanCollide = false
			TweenService:Create(p, TweenInfo.new(1.4), { Transparency = 1 }):Play()
		end
		Debris:AddItem(lock, 6)
	end
	stations[i] = s
	return s
end

local function buildNeighborhood()
	local n = Instance.new("Model")
	n.Name = "Neighborhood"
	n.Parent = world
	mk(n, "Yard", Vector3.new(300, 0.2, 400), Vector3.new(200, 0.1, -1300), rgb(40, 36, 32), Enum.Material.Slate)
	mk(n, "MainStreet", Vector3.new(20, 0.1, 400), Vector3.new(200, 0.25, -1300), rgb(32, 32, 35), Enum.Material.Asphalt)
	mk(n, "Cross1", Vector3.new(300, 0.1, 16), Vector3.new(200, 0.25, -1250), rgb(32, 32, 35), Enum.Material.Asphalt)
	mk(n, "Cross2", Vector3.new(300, 0.1, 16), Vector3.new(200, 0.25, -1400), rgb(32, 32, 35), Enum.Material.Asphalt)
	local wallC = rgb(55, 50, 48)
	local wm = Enum.Material.Brick
	mk(n, "WallN", Vector3.new(300, 24, 2), Vector3.new(200, 12, -1500), wallC, wm)
	mk(n, "WallW", Vector3.new(2, 24, 400), Vector3.new(50, 12, -1300), wallC, wm)
	mk(n, "WallE", Vector3.new(2, 24, 400), Vector3.new(350, 12, -1300), wallC, wm)
	mk(n, "WallSW", Vector3.new(138, 24, 2), Vector3.new(119, 12, -1100), wallC, wm)
	mk(n, "WallSE", Vector3.new(138, 24, 2), Vector3.new(281, 12, -1100), wallC, wm)
	mk(n, "PillarL", Vector3.new(4, 20, 4), Vector3.new(186, 10, -1100), rgb(45, 42, 42), wm)
	mk(n, "PillarR", Vector3.new(4, 20, 4), Vector3.new(214, 10, -1100), rgb(45, 42, 42), wm)
	local arch = mk(n, "Arch", Vector3.new(34, 6, 3), Vector3.new(200, 22, -1100), rgb(40, 38, 38), wm)
	sgText(arch, Enum.NormalId.Back, "الحارة المسكونة", rgb(200, 40, 40))
	gateLeaves.L = makeLeaf("GateL")
	gateLeaves.R = makeLeaf("GateR")
	setGate(90) -- مفتوحة في البداية

	local cols = { { x = 100, dir = 1 }, { x = 155, dir = 1 }, { x = 245, dir = -1 }, { x = 300, dir = -1 } }
	local rows = { -1160, -1210, -1300, -1350, -1450 }
	local idx = 0
	for _, r in ipairs(rows) do
		for _, c in ipairs(cols) do
			idx += 1
			buildHouse(n, idx, c.x, r, c.dir)
		end
	end
	local k = 0
	local lz = -1140
	while lz > -1490 do
		k += 1
		local side = (k % 2 == 0) and 1 or -1
		lampPost(n, Vector3.new(200 + side * 12, 0, lz), side, math.random() < 0.5)
		lz -= 45
	end
	for i, def in ipairs(STATION_DEFS) do
		buildStation(n, i, def)
	end
end

