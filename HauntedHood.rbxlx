------------------------------------------------------------------
local CFG = {
	Sounds = {
		Shutter = "rbxasset://sounds/snap.mp3",
		Switch = "rbxasset://sounds/switch.mp3",
		Unlock = "rbxasset://sounds/button.wav",
		Gun = "", -- صوت المسدس
		Slam = "", -- صوت قفل البوابة
		Whisper = "", -- همسات
		Scare = "", -- صوت الرعب المفاجئ
		Ghost = "", -- ظهور جني
		Siren = "", -- صفارة الإنذار
		Ambient = "", -- موسيقى رعب خلفية (تتكرر)
	},
}
for k, v in pairs(CFG.Sounds) do
	RS:SetAttribute("Snd_" .. k, v)
end

------------------------------------------------------------------
-- Remotes
------------------------------------------------------------------
local ToClient = Instance.new("RemoteEvent")
ToClient.Name = "ToClient"
ToClient.Parent = RS
local ToServer = Instance.new("RemoteEvent")
ToServer.Name = "ToServer"
ToServer.Parent = RS
local Templates = Instance.new("Folder")
Templates.Name = "Templates"
Templates.Parent = RS

------------------------------------------------------------------
-- أدوات مساعدة
------------------------------------------------------------------
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local world = Instance.new("Folder")
world.Name = "HorrorWorld"
world.Parent = workspace

local function mk(parent, name, size, cf, color, mat, transp)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	if typeof(cf) == "Vector3" then
		cf = CFrame.new(cf)
	end
	p.CFrame = cf
	p.Color = color or rgb(60, 60, 60)
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function addLight(parent, kind, color, brightness, range)
	local l = Instance.new(kind)
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Parent = parent
	return l
end

local function sgText(part, face, text, color)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 30
	g.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or rgb(255, 255, 255)
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.Parent = g
	return l
end

local allLights = {} -- الأضواء اللي تتحول للأحمر
local flickers = {} -- الأضواء اللي ترمش
local function regLight(l, canFlicker)
	l:SetAttribute("Orig", l.Color)
	table.insert(allLights, l)
	if canFlicker then
		table.insert(flickers, { light = l, base = l.Brightness })
	end
end

local mainPlayer = nil
local function tell(...)
	if mainPlayer and mainPlayer.Parent then
		ToClient:FireClient(mainPlayer, ...)
	end
end
local function sub(who, text, hold)
	tell("Sub", who, text, hold or 2.5)
end
local function mission(text, pos)
	tell("Mission", text, pos)
end

local function prompt(parent, action, object, hold, fn)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0.5
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	pp.Triggered:Connect(function(plr)
		if plr == mainPlayer then
			fn(plr)
		end
	end)
	return pp
end

local function placeCar(car, cf)
	car:PivotTo(cf * CFrame.new(0, 2, 0))
end

