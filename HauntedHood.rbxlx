------------------------------------------------------------------
-- الأضواء الحمراء (لما يبدأ الرعب)
------------------------------------------------------------------
local redOn = false
local function redLights(on)
	redOn = on
	local ti = TweenInfo.new(2)
	local cc = Lighting:FindFirstChild("HorrorCC")
	if on then
		TweenService:Create(Lighting, ti, { Ambient = rgb(70, 5, 5), OutdoorAmbient = rgb(110, 8, 8), FogColor = rgb(80, 8, 8) }):Play()
		if cc then
			TweenService:Create(cc, ti, { TintColor = rgb(255, 130, 130) }):Play()
		end
		for _, l in ipairs(allLights) do
			l.Color = rgb(255, 40, 40)
		end
		task.spawn(function()
			local up = true
			while redOn do
				TweenService:Create(Lighting, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { OutdoorAmbient = up and rgb(160, 12, 12) or rgb(60, 3, 3) }):Play()
				up = not up
				task.wait(0.9)
			end
		end)
	else
		TweenService:Create(Lighting, ti, { Ambient = rgb(20, 22, 32), OutdoorAmbient = rgb(28, 30, 44), FogColor = rgb(55, 62, 72) }):Play()
		if cc then
			TweenService:Create(cc, ti, { TintColor = rgb(215, 225, 255) }):Play()
		end
		for _, l in ipairs(allLights) do
			l.Color = l:GetAttribute("Orig") or rgb(255, 200, 130)
		end
	end
end

------------------------------------------------------------------
-- الأدوات (مسدس / كشاف / جوال)
------------------------------------------------------------------
local function weldTo(handle, part, offset)
	local w = Instance.new("Weld")
	w.Part0 = handle
	w.Part1 = part
	w.C0 = offset
	w.Parent = handle
end

local function newTool(name, size, color)
	local t = Instance.new("Tool")
	t.Name = name
	t.CanBeDropped = false
	t.RequiresHandle = true
	t.GripForward = Vector3.new(-1, 0, 0)
	t.GripRight = Vector3.new(0, 1, 0)
	t.GripUp = Vector3.new(0, 0, 1)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = size
	h.Color = color
	h.Material = Enum.Material.Metal
	h.CanCollide = false
	h.Parent = t
	return t, h
end

local function extraPart(tool, handle, size, offset, color, mat)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.Metal
	p.CanCollide = false
	p.Massless = true
	p.Parent = tool
	weldTo(handle, p, offset)
	return p
end

local function giveGear()
	local plr = mainPlayer
	if not plr then
		return
	end
	local bp = plr:WaitForChild("Backpack", 5)
	if not bp then
		return
	end
	for _, n in ipairs({ "Pistol", "Flashlight", "Phone" }) do
		local old = bp:FindFirstChild(n)
		if old then
			old:Destroy()
		end
	end
	-- مسدس
	local pistol, ph = newTool("Pistol", Vector3.new(0.35, 0.5, 1.5), rgb(25, 25, 28))
	pistol.ToolTip = "مسدس"
	extraPart(pistol, ph, Vector3.new(0.3, 1, 0.45), CFrame.new(0, -0.7, -0.45), rgb(20, 20, 20))
	pistol.Parent = bp
	-- كشاف
	local fl, fh = newTool("Flashlight", Vector3.new(0.5, 0.5, 1.6), rgb(80, 80, 90))
	fl.ToolTip = "كشاف"
	extraPart(fl, fh, Vector3.new(0.9, 0.9, 0.5), CFrame.new(0, 0, 1.0), rgb(255, 240, 180), Enum.Material.Neon)
	fl.Equipped:Connect(function()
		local char = fl.Parent
		local head = char and char:FindFirstChild("Head")
		if head and not head:FindFirstChild("FlashBeam") then
			local sl = Instance.new("SpotLight")
			sl.Name = "FlashBeam"
			sl.Brightness = 4
			sl.Range = 60
			sl.Angle = 55
			sl.Face = Enum.NormalId.Front
			sl.Color = rgb(255, 245, 215)
			sl.Parent = head
		end
	end)
	fl.Unequipped:Connect(function()
		local head = plr.Character and plr.Character:FindFirstChild("Head")
		local b = head and head:FindFirstChild("FlashBeam")
		if b then
			b:Destroy()
		end
	end)
	fl.Activated:Connect(function()
		local head = plr.Character and plr.Character:FindFirstChild("Head")
		local b = head and head:FindFirstChild("FlashBeam")
		if b then
			b.Enabled = not b.Enabled
			tell("Sfx", "Switch")
		end
	end)
	fl.Parent = bp
	-- جوال
	local ph2, phh = newTool("Phone", Vector3.new(0.9, 0.12, 1.7), rgb(15, 15, 18))
	ph2.ToolTip = "جوال - صوّر الدلائل"
	extraPart(ph2, phh, Vector3.new(0.8, 0.02, 1.5), CFrame.new(0, 0.07, 0), rgb(70, 130, 255), Enum.Material.Neon)
	ph2.Parent = bp
end

------------------------------------------------------------------
-- اللاعب: ظهور وموت
------------------------------------------------------------------
local SPAWN_CF = CFrame.new(191.5, 4, -1117)

local function respawnCF()
	if State.stage >= 6 then
		return CFrame.new(200, 4, -1160)
	end
	return SPAWN_CF
end

local function spawnPlayer(cf)
	if not mainPlayer then
		return
	end
	mainPlayer:LoadCharacter()
	local char = mainPlayer.Character or mainPlayer.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart")
	char:PivotTo(cf)
	local hum = char:WaitForChild("Humanoid")
	hum.WalkSpeed = 15
	if State.gear then
		giveGear()
	end
	hum.Died:Connect(function()
		tell("Died")
		task.wait(4)
		if mainPlayer and mainPlayer.Parent and State.stage >= 1 and State.stage < 8 then
			spawnPlayer(respawnCF())
			tell("Revived")
		end
	end)
end

------------------------------------------------------------------
-- القصة: المفاتيح والأقفال
------------------------------------------------------------------
local function nearest(list, getPos)
	local char = mainPlayer and mainPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local best, bd = nil, math.huge
	for k, item in pairs(list) do
		local p = getPos(item, k)
		if p then
			local d = hrp and (hrp.Position - p).Magnitude or 0
			if d < bd then
				best, bd = p, d
			end
		end
	end
	return best
end

local function makeKeyModel(color)
	local m = Instance.new("Model")
	m.Name = "Key"
	local ring = mk(m, "Ring", Vector3.new(0.3, 1.8, 1.8), CFrame.new(0, 0, 0), color, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	mk(m, "Shaft", Vector3.new(0.3, 0.4, 2.6), CFrame.new(0, 0, -2.1), color, Enum.Material.Neon)
	mk(m, "Tooth1", Vector3.new(0.3, 0.9, 0.4), CFrame.new(0, -0.5, -3.0), color, Enum.Material.Neon)
	mk(m, "Tooth2", Vector3.new(0.3, 0.7, 0.4), CFrame.new(0, -0.4, -2.2), color, Enum.Material.Neon)
	for _, p in ipairs(m:GetChildren()) do
		p.CanCollide = false
	end
	addLight(ring, "PointLight", color, 1.2, 14)
	m.PrimaryPart = ring
	return m
end

local function spawnKey(i, pos, onPick)
	local km = makeKeyModel(KEYS[i].color)
	km.Name = "Key" .. i
	km:PivotTo(CFrame.new(pos + Vector3.new(0, 1.3, 0)))
	km.Parent = world
	km:SetAttribute("Base", km:GetPivot())
	CollectionService:AddTag(km, "Spin")
	prompt(km.Ring, "التقاط", "المفتاح " .. KEYS[i].name, 0.5, function()
		km:Destroy()
		onPick()
	end)
end

local nextKeyStep, startNotes, startWave

local function unlockStation(i)
	State.unlocked[i] = true
	tell("Sfx", "Unlock")
	stations[i].unlock()
	sub("أنا", "انفتح قفل " .. KEYS[i].name .. "!", 2.5)
	task.delay(2.5, nextKeyStep)
end

function nextKeyStep()
	State.keyStep += 1
	local i = State.keyStep
	if i > 5 then
		startNotes()
		return
	end
	local h = roles.keys[i]
	spawnKey(i, h.tableA, function()
		State.hasKey[i] = true
		tell("Sfx", "Switch")
		sub("أنا", "حصلت على المفتاح " .. KEYS[i].name .. ".. أبحث عن قفله.", 3)
		mission(("افتح القفل %s (%d/6)"):format(KEYS[i].name, i), stations[i].pos)
	end)
	mission(("ابحث عن المفتاح %s (%d/6)"):format(KEYS[i].name, i), h.tableA)
end

-- أقفال الأبواب الخمسة
for i = 1, 5 do
	prompt(stations[i].lock, "فتح القفل", "القفل " .. KEYS[i].name, 1, function()
		if State.stage ~= 3 or State.unlocked[i] then
			return
		end
		if State.hasKey[i] then
			unlockStation(i)
		else
			sub("أنا", "أحتاج المفتاح " .. KEYS[i].name .. " أولاً.", 2.5)
		end
	end)
end

------------------------------------------------------------------
-- الأوراق + الخزنة (لغز المفتاح الأبيض)
------------------------------------------------------------------
local safeDoor, safeBody, safePos

local function nearestNotePos()
	return nearest(roles.notes, function(h, k)
		if State.notesGot[k] then
			return nil
		end
		return h.tableB
	end)
end

local function buildSafe()
	local h = roles.safe
	safePos = Vector3.new(h.center.X - h.dir * 14.8, 0.4 + 1.5, h.center.Z)
	safeBody = mk(world, "Safe", Vector3.new(2.4, 3, 3.2), safePos, rgb(60, 62, 68), Enum.Material.Metal)
	safeDoor = mk(world, "SafeDoor", Vector3.new(0.3, 2.6, 2.8), safePos + Vector3.new(h.dir * 1.35, 0, 0), rgb(85, 88, 95), Enum.Material.Metal)
	local dial = mk(world, "Dial", Vector3.new(0.6, 0.6, 0.3), safePos + Vector3.new(h.dir * 1.6, 0, 0), rgb(255, 255, 255), Enum.Material.Neon)
	dial.Shape = Enum.PartType.Ball
	prompt(safeBody, "فتح الخزنة", "خزنة قديمة", 0.6, function()
		if State.stage ~= 4 then
			return
		end
		if State.noteCount < 4 then
			sub("أنا", "خزنة بقفل رقمي.. لازم ألقى الأوراق الأربع أول.", 3)
			return
		end
		tell("Keypad")
	end)
end
buildSafe()

local function openSafe()
	local h = roles.safe
	State.stage = 5
	tell("Sfx", "Unlock")
	local hinge = safeDoor.CFrame * CFrame.new(0, 0, -1.4)
	local target = hinge * CFrame.Angles(0, h.dir * math.rad(100), 0) * CFrame.new(0, 0, 1.4)
	TweenService:Create(safeDoor, TweenInfo.new(1.2), { CFrame = target }):Play()
	spawnKey(6, safePos + Vector3.new(h.dir * 0.2, -0.6, 0), function()
		State.hasKey[6] = true
		sub("أنا", "المفتاح الأبيض!.. لازم أطلع من هذا البيت بسرعة.", 3)
		mission("اخرج من البيت", h.doorPos)
		task.spawn(function()
			while State.stage == 5 do
				local char = mainPlayer and mainPlayer.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local rel = hrp.Position - h.center
					if math.abs(rel.X) > 18.5 or math.abs(rel.Z) > 15.5 then
						startWave()
						break
					end
				end
				task.wait(0.4)
			end
		end)
	end)
	mission("خذ المفتاح الأبيض من الخزنة", safePos)
end

function startNotes()
	State.stage = 4
	State.code = { math.random(1, 9), math.random(0, 9), math.random(0, 9), math.random(0, 9) }
	for k = 1, 4 do
		local h = roles.notes[k]
		local paper = mk(world, "Note" .. k, Vector3.new(1.6, 0.1, 2), CFrame.new(h.tableB + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, math.rad(math.random(-40, 40)), 0), rgb(235, 225, 190))
		paper.CanCollide = false
		addLight(paper, "PointLight", rgb(255, 240, 200), 0.8, 10)
		prompt(paper, "قراءة الورقة", "ورقة ممزقة", 0.4, function()
			if State.notesGot[k] then
				return
			end
			State.notesGot[k] = true
			State.noteCount += 1
			paper:Destroy()
			tell("NoteDigit", k, State.code[k])
			sub("أنا", ("ورقة %d: الرقم %d"):format(k, State.code[k]), 3)
			if State.noteCount >= 4 then
				mission("جمعت الأرقام.. افتح الخزنة", safePos)
			else
				mission(("ابحث عن أوراق الرمز (%d/4)"):format(State.noteCount), nearestNotePos())
			end
		end)
	end
	sub("أنا", "المفتاح الأخير مقفل في خزنة.. أكيد الرمز مكتوب في أوراق مبعثرة بالبيوت.", 4)
	mission("ابحث عن أوراق الرمز (0/4)", nearestNotePos())
end

------------------------------------------------------------------
-- الموجة الحمراء: 30 جني
------------------------------------------------------------------
function startWave()
	if State.stage ~= 5 then
		return
	end
	State.stage = 6
	tell("Stalker", false)
	tell("Halluc", false)
	redLights(true)
	tell("Sfx", "Siren")
	tell("Wave", 30)
	sub("أنا", "اشتغلت الأضواء الحمراء!.. هذي الجن.. لازم أقتلهم كلهم!", 4)
	mission("اقتل الجن (30)", nil)
end

local gateLock
local function buildGateLock()
	gateLock = mk(world, "WhiteLock", Vector3.new(2.2, 3, 1.2), Vector3.new(200, 6, -1100.9), rgb(255, 255, 255), Enum.Material.Neon)
	mk(world, "GateChain", Vector3.new(24, 0.5, 0.5), CFrame.new(200, 6.6, -1100.6) * CFrame.Angles(0, 0, math.rad(3)), rgb(70, 70, 75), Enum.Material.Metal)
	addLight(gateLock, "PointLight", rgb(255, 255, 255), 1, 16)
	local pp = prompt(gateLock, "فتح البوابة", "القفل الأبيض", 1.2, function()
		if State.stage ~= 7 then
			return
		end
		State.stage = 8
		tell("Sfx", "Unlock")
		gateLock.Anchored = false
		local nv = Instance.new("NumberValue")
		nv.Value = 0
		nv.Changed:Connect(function(v)
			setGate(v)
		end)
		TweenService:Create(nv, TweenInfo.new(3, Enum.EasingStyle.Quad), { Value = 90 }):Play()
		task.delay(2, function()
			tell("Ending")
		end)
	end)
	pp.Enabled = false
	return pp
end
local gatePrompt

local function finishWaveServer()
	if State.stage ~= 6 then
		return
	end
	State.stage = 7
	redLights(false)
	sub("أنا", "انتهوا... البوابة! المفتاح الأبيض يفتح القفل الأخير.", 4)
	mission("افتح قفل البوابة بالمفتاح الأبيض", Vector3.new(200, 6, -1100))
	if gatePrompt then
		gatePrompt.Enabled = true
	end
end

------------------------------------------------------------------
-- الدلائل + صندوق السيارة
------------------------------------------------------------------
local function evidenceMission()
	local c = (State.photos.car and 1 or 0) + (State.photos.body and 1 or 0)
	local pos
	if not State.photos.car then
		pos = wreck.Body.Position
	else
		pos = bodyModel.Torso.Position
	end
	mission(("صوّر الدلائل بالجوال: سيارته + جثته (%d/2)"):format(c), pos)
end

local function handlePhoto(cf)
	if typeof(cf) ~= "CFrame" or State.stage ~= 2 then
		return
	end
	local char = mainPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or (cf.Position - hrp.Position).Magnitude > 25 then
		return
	end
	local function check(done, model, pos)
		if done then
			return false
		end
		local d = pos - cf.Position
		if d.Magnitude > 60 or d.Magnitude < 1 then
			return false
		end
		if d.Unit:Dot(cf.LookVector) < 0.88 then
			return false
		end
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = { char }
		local r = workspace:Raycast(cf.Position, d, rp)
		if r and not r.Instance:IsDescendantOf(model) then
			return false
		end
		return true
	end
	local got = false
	if check(State.photos.car, wreck, wreck.Body.Position) then
		State.photos.car = true
		got = true
		sub("أنا", "صورت سيارة الشرطي.. محطمة تماماً!", 3)
	elseif check(State.photos.body, bodyModel, bodyModel.Torso.Position) then
		State.photos.body = true
		got = true
		sub("أنا", "هذي جثته... الله يرحمه. صورتها.", 3)
	end
	tell("PhotoResult", got)
	if got then
		if State.photos.car and State.photos.body then
			State.stage = 3
			task.delay(3.5, function()
				sub("أنا", "الباب انقفل بالسلاسل.. لازم ألقى 6 مفاتيح وأفتح الأقفال.", 4)
				task.delay(4, nextKeyStep)
			end)
			mission("تم تصوير الدلائل ✔", nil)
		else
			evidenceMission()
		end
	end
end

local parkedCar
local PARK_CF = CFrame.new(200, 0.3, -1120)

local function buildParkedCar()
	parkedCar = Templates.PoliceCar:Clone()
	placeCar(parkedCar, PARK_CF)
	parkedCar.Parent = world
	local trunk = parkedCar.Trunk
	local gear = parkedCar.Gear
	local base = trunk.CFrame
	local pp
	pp = prompt(trunk, "فتح الصندوق", "سيارة الشرطة", 0.8, function()
		if State.stage ~= 1 then
			return
		end
		State.stage = 2
		pp:Destroy()
		TweenService:Create(trunk, TweenInfo.new(0.9), { CFrame = base * CFrame.new(0, 0, -1.5) * CFrame.Angles(math.rad(-65), 0, 0) * CFrame.new(0, 0, 1.5) }):Play()
		tell("Sfx", "Switch")
		State.gear = true
		giveGear()
		gear.Transparency = 0
		task.delay(1.5, function()
			gear:Destroy()
		end)
		sub("أنا", "مسدس.. كشاف.. وجوال للتصوير. وأحس أن شيء يراقبني!", 4)
		local spots = {}
		for _, h in ipairs(roles.ritual) do
			table.insert(spots, { center = h.center, dir = h.dir })
		end
		task.delay(3, function()
			tell("Rituals", spots)
			tell("Stalker", true)
			tell("Halluc", true)
			evidenceMission()
		end)
	end)
end

------------------------------------------------------------------
-- نهاية المقدمة
------------------------------------------------------------------
local function onIntroDone()
	if State.stage ~= 0 then
		return
	end
	State.stage = 1
	setGate(0)
	buildParkedCar()
	gatePrompt = buildGateLock()
	spawnPlayer(SPAWN_CF)
	mission("اذهب إلى صندوق السيارة وخذ المستلزمات", PARK_CF.Position + Vector3.new(0, 3, 7))
	sub("أنا", "البوابة انقفلت!.. أحتاج أجهز نفسي أول.", 3.5)
end

------------------------------------------------------------------
-- استقبال أحداث العميل
------------------------------------------------------------------
ToServer.OnServerEvent:Connect(function(plr, action, a)
	if plr ~= mainPlayer then
		return
	end
	if action == "ClientReady" then
		if not State.introStarted then
			State.introStarted = true
			task.wait(1)
			ToClient:FireClient(plr, "PlayIntro")
		end
	elseif action == "IntroDone" then
		onIntroDone()
	elseif action == "Photo" then
		handlePhoto(a)
	elseif action == "Code" then
		if State.stage ~= 4 or State.noteCount < 4 or typeof(a) ~= "string" then
			return
		end
		local right = table.concat(State.code, "")
		if a == right then
			tell("CodeResult", true)
			openSafe()
		else
			tell("CodeResult", false)
			tell("Sfx", "Scare")
		end
	elseif action == "Hurt" then
		if State.stage >= 2 and typeof(a) == "number" then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				hum:TakeDamage(math.clamp(a, 1, 35))
			end
		end
	elseif action == "WaveDone" then
		finishWaveServer()
	end
end)

Players.PlayerAdded:Connect(function(plr)
	if mainPlayer then
		plr:Kick("هذي الماب للاعب واحد فقط - ادخل سيرفر خاص ثاني.")
		return
	end
	mainPlayer = plr
end)
for _, p in ipairs(Players:GetPlayers()) do
	if not mainPlayer then
		mainPlayer = p
	end
end
Players.PlayerRemoving:Connect(function(plr)
	if plr == mainPlayer then
		mainPlayer = nil
	end
end)
