}, kp)
new("UIGridLayout", { CellSize = UDim2.fromScale(0.31, 0.23), CellPadding = UDim2.fromScale(0.02, 0.02), SortOrder = Enum.SortOrder.LayoutOrder }, kpGrid)
local entry = ""
local function kpShow()
	kpDisp.Text = entry .. string.rep("_", 4 - #entry)
end
for i, label in ipairs({ "1", "2", "3", "4", "5", "6", "7", "8", "9", "X", "0", "OK" }) do
	local b = new("TextButton", {
		Text = label, Font = FONT, TextScaled = true, TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = (label == "OK") and rgb(30, 120, 50) or ((label == "X") and rgb(120, 30, 30) or rgb(50, 50, 58)),
		LayoutOrder = i, ZIndex = 62, BorderSizePixel = 0,
	}, kpGrid)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, b)
	b.MouseButton1Click:Connect(function()
		if label == "X" then
			if #entry > 0 then
				entry = entry:sub(1, -2)
			else
				kp.Visible = false
			end
		elseif label == "OK" then
			if #entry == 4 then
				ToServer:FireServer("Code", entry)
				entry = ""
			end
		elseif #entry < 4 then
			entry = entry .. label
		end
		kpShow()
	end)
end

------------------------------------------------------------------
-- تأثيرات الشاشة
------------------------------------------------------------------
local function fade(target, t)
	TweenService:Create(black, TweenInfo.new(t), { BackgroundTransparency = target }):Play()
end

local function flash(color, alpha, t)
	flashF.BackgroundColor3 = color
	flashF.BackgroundTransparency = alpha
	TweenService:Create(flashF, TweenInfo.new(t), { BackgroundTransparency = 1 }):Play()
end

local shake = 0
local function doShake(a)
	shake = math.max(shake, a)
end

local function hurtFx()
	hurtF.BackgroundTransparency = 0.45
	TweenService:Create(hurtF, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	doShake(0.5)
end

local function title(text, dur)
	bigLbl.Text = text
	TweenService:Create(bigLbl, TweenInfo.new(0.8), { TextTransparency = 0 }):Play()
	task.wait(dur)
	TweenService:Create(bigLbl, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
	task.wait(0.8)
end

local subToken = 0
local function say(who, text, hold)
	subToken += 1
	local my = subToken
	subBox.Visible = true
	subWho.Text = who or ""
	subTxt.Text = text
	subTxt.MaxVisibleGraphemes = 0
	local n = utf8.len(text) or #text
	for i = 1, n do
		if my ~= subToken then
			return
		end
		subTxt.MaxVisibleGraphemes = i
		task.wait(0.03)
	end
	subTxt.MaxVisibleGraphemes = -1
	task.wait(hold or 2)
	if my == subToken then
		subBox.Visible = false
	end
end

local function scare()
	black.BackgroundTransparency = 0
	task.delay(0.07, function()
		flash(rgb(200, 0, 0), 0.2, 0.6)
		black.BackgroundTransparency = 1
	end)
	doShake(1.4)
	sfx("Scare", 1)
	cam.FieldOfView = 45
	TweenService:Create(cam, TweenInfo.new(0.6), { FieldOfView = 70 }):Play()
end

local function hurt(n)
	ToServer:FireServer("Hurt", n)
	hurtFx()
end

------------------------------------------------------------------
-- نظام الكاميرا (للمشاهد السينمائية + اهتزاز)
------------------------------------------------------------------
local camFn = nil
RunService:BindToRenderStep("HorrorCam", Enum.RenderPriority.Camera.Value + 1, function()
	if camFn then
		camFn()
	end
	if shake > 0.005 then
		if cam.CameraType == Enum.CameraType.Scriptable then
			cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0) * CFrame.Angles(0, 0, (math.random() - 0.5) * shake * 0.04)
		else
			local h = getHum()
			if h then
				h.CameraOffset = Vector3.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
			end
		end
		shake *= 0.92
	elseif cam.CameraType ~= Enum.CameraType.Scriptable then
		local h = getHum()
		if h and h.CameraOffset ~= Vector3.zero then
			h.CameraOffset = Vector3.zero
		end
	end
end)

local function camMove(a, b, dur, fovA, fovB)
	local t0 = os.clock()
	camFn = function()
		local k = math.clamp((os.clock() - t0) / dur, 0, 1)
		k = k * k * (3 - 2 * k)
		cam.CFrame = a:Lerp(b, k)
		if fovA then
			cam.FieldOfView = fovA + (fovB - fovA) * k
		end
	end
end

------------------------------------------------------------------
-- المقدمة السينمائية
------------------------------------------------------------------
local function placeCar(car, cf)
	car:PivotTo(cf * CFrame.new(0, 2, 0))
end

local HL = CFrame.new(188, 7, -1100)
local HR = CFrame.new(212, 7, -1100)
local function setGateLocal(deg)
	local a = math.rad(deg)
	local gl, gr = world:FindFirstChild("GateL"), world:FindFirstChild("GateR")
	if gl then
		gl:PivotTo(HL * CFrame.Angles(0, a, 0) * CFrame.new(6, 0, 0))
	end
	if gr then
		gr:PivotTo(HR * CFrame.Angles(0, -a, 0) * CFrame.new(-6, 0, 0))
	end
end

local function dist(t)
	local tc = 13.68
	if t < 2 then
		return 0.5 * 35 * t * t
	elseif t < 2 + tc then
		return 70 + 70 * (t - 2)
	else
		local td = math.min(t - 2 - tc, 3.5)
		return 70 + 70 * tc + 70 * td - 10 * td * td
	end
end

local function runDrive()
	local tpl = RS:WaitForChild("Templates"):WaitForChild("PoliceCar")
	local car = tpl:Clone()
	car.Parent = workspace
	local startZ = 30
	placeCar(car, CFrame.new(200, 0.3, startZ))
	local pv = car:GetPivot()
	local wheels = {}
	for _, w in ipairs(car:GetChildren()) do
		if w.Name:sub(1, 5) == "Wheel" then
			table.insert(wheels, { part = w, off = pv:ToObjectSpace(w.CFrame) })
		end
	end
	local T = 19.18
	local static2
	local t0 = os.clock()
	camFn = function()
		local t = os.clock() - t0
		local d = dist(t)
		local cf = CFrame.new(200, 0.3, startZ - d) * CFrame.Angles(0, 0, math.sin(t * 3) * 0.012)
		placeCar(car, cf)
		local pvn = car:GetPivot()
		for _, w in ipairs(wheels) do
			w.part.CFrame = pvn * w.off * CFrame.Angles(-d / 1.2, 0, 0)
		end
		local cp = cf.Position + Vector3.new(0, 2, 0)
		if t < 4.5 then
			cam.CFrame = CFrame.lookAt((cf * CFrame.new(7, 4.5, 17 + t * 0.5)).Position, cp)
			cam.FieldOfView = 65
		elseif t < 8.5 then
			static2 = static2 or Vector3.new(214, 3, cf.Position.Z - 180)
			cam.CFrame = CFrame.lookAt(static2, cp)
			cam.FieldOfView = 55
		elseif t < 11.5 then
			cam.CFrame = CFrame.lookAt((cf * CFrame.new(-9, 1.6, -4 + (t - 8.5))).Position, cp)
			cam.FieldOfView = 70
		elseif t < 14 then
			cam.CFrame = CFrame.lookAt((cf * CFrame.new(0, 38, 10)).Position, cp)
			cam.FieldOfView = 70
		else
			cam.CFrame = CFrame.lookAt(Vector3.new(206, 3.2, -1165), cp)
			cam.FieldOfView = 65
		end
	end
	task.wait(T + 0.3)
	return car
end

local function playIntro()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)
	cam.CameraType = Enum.CameraType.Scriptable
	local OFF = Vector3.new(0, 500, 0)
	local office = world:WaitForChild("Office")
	local mgr = office:WaitForChild("Manager")
	local mHead, mRArm = mgr:WaitForChild("Head"), mgr:WaitForChild("RArm")
	local h0, a0 = mHead.CFrame, mRArm.CFrame
	local talking = true
	local mConn = RunService.RenderStepped:Connect(function()
		if talking then
			local t = os.clock()
			mHead.CFrame = h0 * CFrame.Angles(math.sin(t * 3) * 0.06, math.sin(t * 1.7) * 0.12, 0)
			mRArm.CFrame = a0 * CFrame.new(0, 1, 0) * CFrame.Angles(math.sin(t * 2.4) * 0.5 + 0.3, 0, 0) * CFrame.new(0, -1, 0)
		end
	end)
	local c0 = CFrame.lookAt(OFF + Vector3.new(7, 4.2, 9), OFF + Vector3.new(0, 4.3, -9))
	local c1 = CFrame.lookAt(OFF + Vector3.new(2.5, 4.4, 2), OFF + Vector3.new(0, 4.6, -9))
	camMove(c0, c1, 24, 60, 50)
	task.wait(0.5)
	fade(1, 2.5)
	task.wait(2)
	say("المدير", "شوف.. في شرطي له يومين مختفي ومنقطع اتصاله، بعد ما أرسلناه للحارة المسكونة بعملية فحص.", 1.2)
	say("المدير", "والحكومة فخورة بك.. أنت روح وشوف وش الوضع هناك.", 1.5)
	say("أنت", "تمام أمرك سيدي، بروح الحين.", 1.5)
	talking = false
	fade(0, 3.2)
	task.wait(3.4)
	mConn:Disconnect()
	camFn = nil
	title("هذا أنا.. وفي طريقي إلى الحارة المسكونة", 2.5)
	-- الطريق السريع
	cam.FieldOfView = 65
	fade(1, 2)
	local car = runDrive()
	-- الكاميرا للبوابة
	camMove(cam.CFrame, CFrame.lookAt(Vector3.new(204, 4.5, -1146), Vector3.new(200, 9, -1100)), 2.2, 65, 60)
	task.wait(1.6)
	local gt0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - gt0) / 1.3, 0, 1)
		setGateLocal(90 * (1 - a * a))
		if a >= 1 then
			break
		end
		task.wait()
	end
	setGateLocal(0)
	doShake(1.5)
	sfx("Slam", 1)
	task.wait(2)
	fade(0, 1.5)
	task.wait(1.7)
	camFn = nil
	car:Destroy()
	ToServer:FireServer("IntroDone")
	local char = plr.Character or plr.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart")
	local hum = char:WaitForChild("Humanoid")
	cam.CameraType = Enum.CameraType.Custom
	cam.CameraSubject = hum
	cam.FieldOfView = 70
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)
	fade(1, 2.5)
end

------------------------------------------------------------------
-- المهام
------------------------------------------------------------------
local mText, mTarget = "", nil
local function setMission(text, pos)
	mText, mTarget = text or "", pos
	missionLbl.Visible = (text ~= nil and text ~= "")
	missionLbl.Text = mText
end

task.spawn(function()
	while true do
		task.wait(0.3)
		if missionLbl.Visible then
			local hrp = getHrp()
			if mTarget and hrp then
				missionLbl.Text = mText .. "  •  " .. math.floor((hrp.Position - mTarget).Magnitude) .. " م"
			else
				missionLbl.Text = mText
			end
		end
	end
end)

-- دوران المفاتيح
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for _, m in ipairs(CollectionService:GetTagged("Spin")) do
		local base = m:GetAttribute("Base")
		if base then
			m:PivotTo(base * CFrame.Angles(0, t * 1.6, 0) + Vector3.new(0, math.sin(t * 2) * 0.25, 0))
		end
	end
end)

------------------------------------------------------------------
-- الجن (30)
------------------------------------------------------------------
local ghosts = {}
local kills, TOTAL = 0, 30
local waveActive = false

local function ghostCount()
	local n = 0
	for _ in pairs(ghosts) do
		n += 1
	end
	return n
end

local function updateWaveHud()
	waveHud.Text = "الجن المتبقي: " .. (TOTAL - kills)
end

local function makeGhost()
	local m = Instance.new("Model")
	m.Name = "Ghost"
	local function pt(name, size, off, color, mat, transp, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = mat or Enum.Material.SmoothPlastic
		p.Transparency = transp or 0
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		if shape then
			p.Shape = shape
		end
		p.CFrame = CFrame.new(off)
		p.Parent = m
		return p
	end
	local root = pt("Root", Vector3.new(2, 2, 2), Vector3.new(0, 0, 0), rgb(255, 255, 255), nil, 1)
	root.CanQuery = false
	pt("Head", Vector3.new(2.6, 2.6, 2.6), Vector3.new(0, 3.2, 0), rgb(210, 220, 230), Enum.Material.SmoothPlastic, 0.15, Enum.PartType.Ball)
	pt("EyeL", Vector3.new(0.5, 0.7, 0.2), Vector3.new(-0.6, 3.4, -1.2), rgb(255, 20, 20), Enum.Material.Neon)
	pt("EyeR", Vector3.new(0.5, 0.7, 0.2), Vector3.new(0.6, 3.4, -1.2), rgb(255, 20, 20), Enum.Material.Neon)
	pt("Mouth", Vector3.new(1, 1.2, 0.2), Vector3.new(0, 2.5, -1.25), rgb(10, 0, 0))
	pt("Cloak1", Vector3.new(3, 2.5, 2), Vector3.new(0, 1.4, 0), rgb(160, 180, 200), Enum.Material.SmoothPlastic, 0.3)
	pt("Cloak2", Vector3.new(2.2, 2, 1.6), Vector3.new(0, -0.4, 0), rgb(160, 180, 200), Enum.Material.SmoothPlastic, 0.4)
	pt("Cloak3", Vector3.new(1.2, 1.8, 1), Vector3.new(0, -2, 0), rgb(160, 180, 200), Enum.Material.SmoothPlastic, 0.55)
	pt("ArmL", Vector3.new(0.6, 0.6, 3.2), Vector3.new(-1.8, 1.6, -1.5), rgb(220, 230, 240), Enum.Material.SmoothPlastic, 0.2)
	pt("ArmR", Vector3.new(0.6, 0.6, 3.2), Vector3.new(1.8, 1.6, -1.5), rgb(220, 230, 240), Enum.Material.SmoothPlastic, 0.2)
	local hit = pt("Hit", Vector3.new(3.8, 8, 3.8), Vector3.new(0, 1, 0), rgb(255, 255, 255), nil, 1)
	hit.CanQuery = true
	new("PointLight", { Color = rgb(255, 40, 40), Brightness = 1.4, Range = 14 }, root)
	local pe = new("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(rgb(90, 90, 100)),
		Size = NumberSequence.new(1.5, 3), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(1, 2), Rate = 14, Speed = NumberRange.new(1, 2), EmissionDirection = Enum.NormalId.Bottom,
	}, root)
	pe.Enabled = true
	m.PrimaryPart = root
	return m
end

local function spawnGhost()
	local hrp = getHrp()
	if not hrp then
		return
	end
	local ang = math.random() * math.pi * 2
	local d = 40 + math.random() * 25
	local p = hrp.Position + Vector3.new(math.cos(ang) * d, 0, math.sin(ang) * d)
	p = Vector3.new(math.clamp(p.X, 62, 338), 4, math.clamp(p.Z, -1488, -1112))
	local m = makeGhost()
	m:PivotTo(CFrame.new(p))
	m.Parent = workspace
	for _, part in ipairs(m:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "Root" and part.Name ~= "Hit" then
			local tr = part.Transparency
			part.Transparency = 1
			TweenService:Create(part, TweenInfo.new(1.2), { Transparency = tr }):Play()
		end
	end
	ghosts[m] = { hp = 2, speed = 9 + math.random() * 3.5, lastAtk = 0, born = os.clock() }
	sfx("Ghost", 0.7)
end

local function burst(pos)
	for _ = 1, 10 do
		local p = Instance.new("Part")
		p.Size = Vector3.new(0.5, 0.5, 0.5)
		p.Shape = Enum.PartType.Ball
		p.Material = Enum.Material.Neon
		p.Color = rgb(255, 60, 60)
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Position = pos
		p.Parent = workspace
		local dir = Vector3.new(math.random() - 0.5, math.random() - 0.2, math.random() - 0.5).Unit * (4 + math.random() * 5)
		TweenService:Create(p, TweenInfo.new(0.5), { Position = pos + dir, Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) }):Play()
		Debris:AddItem(p, 0.6)
	end
end

local function clearGhosts()
	for m in pairs(ghosts) do
		m:Destroy()
		ghosts[m] = nil
	end
end

local stalkerOn, hallucOn = false, false
local st, stNext = nil, 0
local busy = false

local function destroyStalker()
	if st then
		st:Destroy()
		st = nil
	end
end

local function finishWave()
	waveActive = false
	clearGhosts()
	waveHud.Visible = false
	ToServer:FireServer("WaveDone")
end

local function hitGhost(m)
	local g = ghosts[m]
	if not g then
		return
	end
	g.hp -= 1
	sfx("Ghost", 0.4)
	if g.hp <= 0 then
		ghosts[m] = nil
		burst(m:GetPivot().Position)
		for _, part in ipairs(m:GetDescendants()) do
			if part:IsA("BasePart") then
				TweenService:Create(part, TweenInfo.new(0.35), { Transparency = 1 }):Play()
			end
		end
		Debris:AddItem(m, 0.5)
		kills += 1
		updateWaveHud()
		flash(rgb(255, 255, 255), 0.85, 0.2)
		if kills >= TOTAL then
			finishWave()
		end
	end
end

local function startWave(total)
	TOTAL = total or 30
	kills = 0
	waveActive = true
	stalkerOn, hallucOn = false, false
	destroyStalker()
	waveHud.Visible = true
	updateWaveHud()
	task.spawn(function()
		local t0 = os.clock()
		while waveActive do
			if alive() then
				local maxAlive = math.clamp(1 + math.floor((os.clock() - t0) / 12), 1, 6)
				local remaining = TOTAL - kills
				local n = ghostCount()
				if n < maxAlive and n < remaining then
					spawnGhost()
				end
			end
			task.wait(2.5 + math.random() * 1.5)
		end
	end)
end

------------------------------------------------------------------
-- المطارد (يتحرك لما ما تشوفه)
------------------------------------------------------------------
local function makeStalker()
	local m = Instance.new("Model")
	m.Name = "Watcher"
	local function p(name, size, off, color, mat)
		local x = Instance.new("Part")
		x.Name = name
		x.Size = size
		x.Color = color
		x.Material = mat or Enum.Material.SmoothPlastic
		x.Anchored = true
		x.CanCollide = false
		x.CanQuery = false
		x.CanTouch = false
		x.CFrame = CFrame.new(off)
		x.Parent = m
		return x
	end
	local dark = rgb(8, 8, 10)
	local torso = p("Torso", Vector3.new(2.2, 3.4, 1.2), Vector3.new(0, 5.6, 0), dark)
	p("Head", Vector3.new(1.5, 1.7, 1.5), Vector3.new(0, 8.1, 0), dark)
	p("EyeL", Vector3.new(0.35, 0.2, 0.1), Vector3.new(-0.35, 8.2, -0.78), Color3.new(1, 1, 1), Enum.Material.Neon)
	p("EyeR", Vector3.new(0.35, 0.2, 0.1), Vector3.new(0.35, 8.2, -0.78), Color3.new(1, 1, 1), Enum.Material.Neon)
	p("ArmL", Vector3.new(0.6, 5, 0.6), Vector3.new(-1.6, 5.2, 0), dark)
	p("ArmR", Vector3.new(0.6, 5, 0.6), Vector3.new(1.6, 5.2, 0), dark)
	p("LegL", Vector3.new(0.9, 4, 0.9), Vector3.new(-0.6, 2, 0), dark)
	p("LegR", Vector3.new(0.9, 4, 0.9), Vector3.new(0.6, 2, 0), dark)
	m.PrimaryPart = torso
	return m
end

local function updateStalker(dt)
	if not stalkerOn then
		destroyStalker()
		return
	end
	local hrp = getHrp()
	if busy or not hrp or not alive() then
		return
	end
	local now = os.clock()
	if not st then
		if now < stNext then
			return
		end
		local ang = math.random() * math.pi * 2
		local d = 70 + math.random() * 20
		local p = hrp.Position + Vector3.new(math.cos(ang) * d, 0, math.sin(ang) * d)
		p = Vector3.new(math.clamp(p.X, 60, 340), 6, math.clamp(p.Z, -1490, -1115))
		st = makeStalker()
		st:PivotTo(CFrame.new(p))
		st.Parent = workspace
		return
	end
	local pos = st:GetPivot().Position
	local flat = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
	local d = flat.Magnitude
	local toSt = pos - cam.CFrame.Position
	local seen = toSt.Magnitude < 130 and toSt.Unit:Dot(cam.CFrame.LookVector) > 0.55
	if d < 6.5 then
		scare()
		hurt(30)
		destroyStalker()
		stNext = now + 25 + math.random() * 15
		return
	end
	if not seen and d > 4 then
		pos = pos + flat.Unit * 8 * dt
	end
	st:PivotTo(CFrame.lookAt(Vector3.new(pos.X, 6, pos.Z), Vector3.new(hrp.Position.X, 6, hrp.Position.Z)))
	if seen and d < 40 then
		doShake(0.05)
	end
end

------------------------------------------------------------------
-- حلقة الجن + المطارد
------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	local hrp = getHrp()
	if hrp and alive() then
		for m, g in pairs(ghosts) do
			local pos = m:GetPivot().Position
			local target = hrp.Position
			local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
			local d = flat.Magnitude
			local age = os.clock() - g.born
			local spd = age < 1.2 and 0 or g.speed
			if d > 3.5 then
				pos = pos + flat.Unit * math.min(spd * dt, d)
			end
			local y = 4 + math.sin(os.clock() * 2 + g.born) * 0.6
			m:PivotTo(CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(target.X, y, target.Z)) * CFrame.Angles(math.rad(8), 0, math.sin(os.clock() * 3 + g.born) * 0.1))
			if d < 5.5 and age > 1.2 and os.clock() - g.lastAtk > 1.4 then
				g.lastAtk = os.clock()
				hurt(10)
			end
		end
	end
	updateStalker(dt)
end)

------------------------------------------------------------------
-- الهلوسة العشوائية + طقوس السحر
------------------------------------------------------------------
local whispers = { "...وراك", "...ارجع", "...ما راح تطلع", "...شفتك", "...تعال" }

local function figureFlash()
	local f = makeStalker()
	local base = cam.CFrame * CFrame.new(0, 0, -20)
	f:PivotTo(CFrame.lookAt(Vector3.new(base.Position.X, 6, base.Position.Z), Vector3.new(cam.CFrame.Position.X, 6, cam.CFrame.Position.Z)))
	f.Parent = workspace
	doShake(0.3)
	flash(rgb(120, 0, 0), 0.8, 0.4)
	sfx("Scare", 0.5)
	task.wait(0.35)
	f:Destroy()
end

local function whisperFx()
	task.spawn(say, "؟؟؟", whispers[math.random(#whispers)], 0.6)
	sfx("Whisper", 0.8)
	doShake(0.2)
end

local function glitch()
	for _ = 1, 3 do
		black.BackgroundTransparency = 0
		task.wait(0.06)
		black.BackgroundTransparency = 1
		task.wait(0.12)
	end
	flash(rgb(255, 0, 0), 0.85, 0.5)
end

task.spawn(function()
	while true do
		task.wait(30 + math.random() * 30)
		if hallucOn and not busy and alive() and not waveActive then
			local k = math.random(3)
			if k == 1 then
				figureFlash()
			elseif k == 2 then
				whisperFx()
			else
				glitch()
			end
		end
	end
end)

local function makeRobe()
	local m = Instance.new("Model")
	m.Name = "RobedFigure"
	local function p(name, size, off, color, mat)
		local x = Instance.new("Part")
		x.Name = name
		x.Size = size
		x.Color = color
		x.Material = mat or Enum.Material.Fabric
		x.Anchored = true
		x.CanCollide = false
		x.CanQuery = false
		x.CFrame = CFrame.new(off)
		x.Parent = m
		return x
	end
	local robe = p("Robe", Vector3.new(2.6, 4.6, 1.8), Vector3.new(0, 0, 0), rgb(18, 10, 10))
	p("Hood", Vector3.new(1.7, 1.7, 1.7), Vector3.new(0, 3.1, 0), rgb(12, 6, 6))
	p("EyeL", Vector3.new(0.3, 0.2, 0.1), Vector3.new(-0.35, 3.15, -0.88), rgb(255, 30, 30), Enum.Material.Neon)
	p("EyeR", Vector3.new(0.3, 0.2, 0.1), Vector3.new(0.35, 3.15, -0.88), rgb(255, 30, 30), Enum.Material.Neon)
	m.PrimaryPart = robe
	return m
end

local ritualSpots = {}
local ritualDone = {}

local function runRitual(spot)
	local hum, hrp = getHum(), getHrp()
	if not hum or not hrp then
		return
	end
	busy = true
	ToServer:FireServer("Busy", true)
	local oldSpeed = hum.WalkSpeed
	hum.WalkSpeed = 0
	hum.JumpHeight = 0
	local folder = Instance.new("Folder")
	folder.Name = "RitualHallucination"
	folder.Parent = workspace
	local c = spot.center
	local ring = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 14, 14), Anchored = true, CanCollide = false, CanQuery = false,
		Material = Enum.Material.Neon, Color = rgb(200, 0, 0), Transparency = 0.35,
		CFrame = CFrame.new(c + Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}, folder)
	local ring2 = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 10, 10), Anchored = true, CanCollide = false, CanQuery = false,
		Material = Enum.Material.SmoothPlastic, Color = rgb(10, 0, 0),
		CFrame = CFrame.new(c + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}, folder)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local cd = new("Part", {
			Size = Vector3.new(0.4, 1.2, 0.4), Anchored = true, CanCollide = false, CanQuery = false, Material = Enum.Material.Neon,
			Color = rgb(255, 170, 60), Position = c + Vector3.new(math.cos(a) * 7.4, 1, math.sin(a) * 7.4),
		}, folder)
		new("PointLight", { Color = rgb(255, 80, 40), Brightness = 1.2, Range = 10 }, cd)
	end
	local figs = {}
	for i = 1, 6 do
		local f = makeRobe()
		f.Parent = folder
		figs[i] = f
	end
	flash(rgb(255, 255, 255), 0.6, 0.5)
	sfx("Whisper", 1)
	doShake(0.4)
	task.spawn(say, "؟؟؟", "...انت هنا.. أخيراً.. انت هنا...", 3)
	local t0 = os.clock()
	local function place(angleOffset)
		for i, f in ipairs(figs) do
			local a = angleOffset + i / 6 * math.pi * 2
			local p = c + Vector3.new(math.cos(a) * 6.2, 2.9, math.sin(a) * 6.2)
			f:PivotTo(CFrame.lookAt(p, Vector3.new(c.X, p.Y, c.Z)))
		end
	end
	while os.clock() - t0 < 5.5 do
		place((os.clock() - t0) * 0.9)
		RunService.RenderStepped:Wait()
	end
	-- يلتفتون عليك كلهم
	local hp = getHrp()
	if hp then
		for _, f in ipairs(figs) do
			local pv = f:GetPivot().Position
			f:PivotTo(CFrame.lookAt(pv, Vector3.new(hp.Position.X, pv.Y, hp.Position.Z)))
		end
	end
	flash(rgb(255, 0, 0), 0.4, 0.8)
	doShake(1)
	sfx("Scare", 1)
	task.wait(1.4)
	black.BackgroundTransparency = 0.0
	task.wait(0.3)
	hum = getHum()
	hp = getHrp()
	if hum and hp then
		hum.PlatformStand = true
		hp.CFrame = hp.CFrame * CFrame.Angles(math.rad(90), 0, 0)
	end
	folder:Destroy()
	task.wait(3.5)
	if hum and hp then
		local pos = hp.Position + Vector3.new(0, 3, 0)
		local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if look.Magnitude < 0.1 then
			look = Vector3.new(0, 0, -1)
		end
		hp.CFrame = CFrame.lookAt(pos, pos + look.Unit)
		hum.PlatformStand = false
		hum.WalkSpeed = oldSpeed
		hum.JumpHeight = 7.2
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	fade(1, 2.5)
	busy = false
	ToServer:FireServer("Busy", false)
	say("أنا", "...وين راحوا؟ كأني كنت أحلم.. لازم أكمل!", 3)
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if hallucOn and not busy and alive() and not waveActive then
			local hrp = getHrp()
			if hrp then
				for i, spot in ipairs(ritualSpots) do
					if not ritualDone[i] and (hrp.Position - spot.center).Magnitude < 11 then
						ritualDone[i] = true
						runRitual(spot)
						break
					end
				end
			end
		end
	end
end)

------------------------------------------------------------------
-- الأدوات: مسدس + جوال
------------------------------------------------------------------
local lastShot = 0
local function shoot(tool)
	if os.clock() - lastShot < 0.33 or not alive() then
		return
	end
	lastShot = os.clock()
	local vp = cam.ViewportSize
	local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { plr.Character }
	local res = workspace:Raycast(ray.Origin, ray.Direction * 400, rp)
	local hitPos = res and res.Position or (ray.Origin + ray.Direction * 400)
	local handle = tool:FindFirstChild("Handle")
	local from = handle and handle.Position or ray.Origin
	local len = (hitPos - from).Magnitude
	local tr = Instance.new("Part")
	tr.Anchored = true
	tr.CanCollide = false
	tr.CanQuery = false
	tr.Material = Enum.Material.Neon
	tr.Color = rgb(255, 230, 120)
	tr.Size = Vector3.new(0.12, 0.12, len)
	tr.CFrame = CFrame.lookAt(from, hitPos) * CFrame.new(0, 0, -len / 2)
	tr.Parent = workspace
	Debris:AddItem(tr, 0.06)
	if handle then
		local fl = new("PointLight", { Color = rgb(255, 200, 100), Brightness = 4, Range = 14 }, handle)
		Debris:AddItem(fl, 0.05)
	end
	sfx("Gun", 0.9)
	doShake(0.25)
	if res then
		local model = res.Instance:FindFirstAncestorWhichIsA("Model")
		if model and ghosts[model] then
			hitGhost(model)
		end
	end
end

local lastPhoto = 0
local function takePhoto()
	if os.clock() - lastPhoto < 1.2 or not alive() then
		return
	end
	lastPhoto = os.clock()
	flash(Color3.new(1, 1, 1), 0, 0.4)
	sfx("Shutter", 1)
	ToServer:FireServer("Photo", cam.CFrame)
end

local function bindTool(tool)
	if tool:GetAttribute("Bound") or not tool:IsA("Tool") then
		return
	end
	tool:SetAttribute("Bound", true)
	if tool.Name == "Pistol" then
		tool.Equipped:Connect(function()
			cross.Visible = true
		end)
		tool.Unequipped:Connect(function()
			cross.Visible = false
		end)
		tool.Activated:Connect(function()
			shoot(tool)
		end)
	elseif tool.Name == "Phone" then
		tool.Equipped:Connect(function()
			viewfinder.Visible = true
		end)
		tool.Unequipped:Connect(function()
			viewfinder.Visible = false
		end)
		tool.Activated:Connect(takePhoto)
	end
end

local function watchBackpack(bp)
	for _, t in ipairs(bp:GetChildren()) do
		bindTool(t)
	end
	bp.ChildAdded:Connect(bindTool)
end

local function onCharacter(char)
	cross.Visible = false
	viewfinder.Visible = false
	char.ChildAdded:Connect(bindTool)
	local bp = plr:WaitForChild("Backpack", 10)
	if bp then
		watchBackpack(bp)
	end
end
plr.CharacterAdded:Connect(onCharacter)
if plr.Character then
	task.spawn(onCharacter, plr.Character)
end

------------------------------------------------------------------
-- الموت والنهاية
------------------------------------------------------------------
local function onDied()
	clearGhosts()
	destroyStalker()
	busy = false
	ToServer:FireServer("Busy", false)
	TweenService:Create(black, TweenInfo.new(2), { BackgroundTransparency = 0.15 }):Play()
	task.spawn(title, "ماتت..", 2.5)
end

local function onEnding()
	fade(0, 3)
	task.wait(3.2)
	subBox.Visible = false
	missionLbl.Visible = false
	waveHud.Visible = false
	bigLbl.Text = "النهاية\nنجوت من الحارة المسكونة.. هل ستعود؟"
	TweenService:Create(bigLbl, TweenInfo.new(1.5), { TextTransparency = 0 }):Play()
end

------------------------------------------------------------------
-- استقبال أحداث السيرفر
------------------------------------------------------------------
local digits = { "_", "_", "_", "_" }

ToClient.OnClientEvent:Connect(function(name, a, b, c)
	if name == "PlayIntro" then
		task.spawn(playIntro)
	elseif name == "Sub" then
		task.spawn(say, a, b, c)
	elseif name == "Mission" then
		setMission(a, b)
	elseif name == "Sfx" then
		sfx(a)
	elseif name == "NoteDigit" then
		digits[a] = tostring(b)
		codeHud.Visible = true
		codeHud.Text = "الرمز: " .. table.concat(digits, " ")
	elseif name == "Keypad" then
		entry = ""
		kpShow()
		kp.Visible = true
	elseif name == "CodeResult" then
		if a then
			kp.Visible = false
		else
			flash(rgb(255, 0, 0), 0.5, 0.5)
			kpDisp.Text = "خطأ!"
			task.delay(0.8, kpShow)
		end
	elseif name == "PhotoResult" then
		if not a then
			task.spawn(say, "أنا", "ما ظهر الدليل بوضوح.. قرّب ووجّه الكاميرا عليه.", 2)
		end
	elseif name == "Stalker" then
		stalkerOn = a
		stNext = os.clock() + 15
	elseif name == "Halluc" then
		hallucOn = a
	elseif name == "Rituals" then
		ritualSpots = a
		ritualDone = {}
	elseif name == "Wave" then
		startWave(a)
	elseif name == "Died" then
		onDied()
	elseif name == "Revived" then
		fade(1, 2)
	elseif name == "Ending" then
		task.spawn(onEnding)
	end
end)

ToServer:FireServer("ClientReady")
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>
